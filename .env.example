# =====================================
# Supabase Configuration (Template)
# =====================================
# This file serves as a template for your local `.env` file.
# It contains the variables required to connect the app to Supabase.
#
# Do NOT commit your actual `.env` file.
# Use this template to create your own local configuration.
#
# -------------------------------------
# Setup Instructions:
# 1. Run: flutter pub get
# 2. Create a file named `.env` in the project root (same level as pubspec.yaml)
# 3. Copy ONLY the two variables below into your `.env` file
# 4. Replace the placeholders with your Supabase project credentials
#
# -------------------------------------
# Where to find values:
# SUPABASE_URL:
#   Found in the Supabase Dashboard -> Project Overview (under project name)
#
# SUPABASE_ANON_KEY:
#   Found in Supabase Dashboard -> Settings -> API -> anon public key
#
# Do NOT use the service_role key.
# =====================================

SUPABASE_URL=https://our-project.supabase.co
SUPABASE_ANON_KEY=our_anon_key_here

# =====================================
# Firebase Web Push Configuration
# =====================================
# Required for Flutter Web FCM init/token registration:
# - register a Web app in Firebase console first
# - copy values from the Firebase Web config snippet

FIREBASE_WEB_API_KEY=your_web_api_key
FIREBASE_WEB_APP_ID=your_web_app_id
FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
FIREBASE_WEB_PROJECT_ID=your_project_id

# Optional overrides (defaults are computed when omitted):
FIREBASE_WEB_AUTH_DOMAIN=your_project_id.firebaseapp.com
FIREBASE_WEB_STORAGE_BUCKET=your_project_id.appspot.com
FIREBASE_WEB_MEASUREMENT_ID=your_measurement_id

# Required for web push token generation:
FIREBASE_WEB_VAPID_KEY=your_web_push_certificate_key_pair
